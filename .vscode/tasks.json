{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "astro:dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Local:\\s*http://localhost:",
          "endsPattern": "watching for file changes|ready|Local:\\s*http://localhost:"
        }
      }
    }
  ]
}
