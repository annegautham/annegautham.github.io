---
// Giscus comments component
// Docs: https://giscus.app/
---

<div class="mt-8 border-t border-skin-line pt-8">
  <h2 class="mb-4 text-2xl font-semibold text-skin-base">Comments</h2>
  <div class="giscus"></div>
</div>

<script>
  function loadGiscus() {
    const theme = "light_protanopia";
    //   localStorage.getItem("theme") === "dark" ? "dark" : "light";

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", "annegautham/annegautham.github.io");
    script.setAttribute("data-repo-id", "R_kgDOJQS4FA");
    script.setAttribute("data-category", "Announcements");
    script.setAttribute("data-category-id", "DIC_kwDOJQS4fM4COMVo");
    script.setAttribute("data-mapping", "pathname");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "bottom");
    script.setAttribute("data-theme", theme);
    script.setAttribute("data-lang", "en");
    script.setAttribute("data-loading", "lazy");
    script.crossOrigin = "anonymous";
    script.async = true;

    const container = document.querySelector(".giscus");
    if (container) {
      container.appendChild(script);
    }
  }

  // Load Giscus on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadGiscus);
  } else {
    loadGiscus();
  }

  // Update theme when user toggles
  document.addEventListener("astro:after-swap", loadGiscus);

  // Listen for theme changes
  const themeToggle = () => {
    const iframe = document.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame"
    );
    if (iframe) {
      const theme = localStorage.getItem("theme") === "dark" ? "dark" : "light";
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme } } },
        "https://giscus.app"
      );
    }
  };

  // Watch for theme changes
  window.addEventListener("storage", themeToggle);

  // For theme toggle button click
  document.addEventListener("click", e => {
    const target = e.target as HTMLElement;
    if (target.id === "theme-btn" || target.closest("#theme-btn")) {
      setTimeout(themeToggle, 100);
    }
  });
</script>

<style>
  .giscus {
    @apply min-h-[200px];
  }
</style>
